#!/command/with-contenv sh

# ===================================================================
# EmbyServer 启动服务（复刻 amilys /etc/services.d/emby-server/run + 修复）
# 每次容器启动：
#   1) 确保 /config/config 存在（首次挂载空 /config 卷时没有！）
#   2) 执行 /etc/regoff.sh（写 mb.lic + hosts 伪 mb3admin + 注册配置）
#   3) 启动 /system/EmbyServer（处理 PUID/PGID/UMASK/dri）
#   ※ ext.sh 已删除（2026-08-31）：前端插件默认全部加载，不再需要每次 sed 注入
# ===================================================================

# ★ 修复：首次运行时 /config/config 目录不存在（空 /config 卷）
mkdir -p /config/config

/etc/regoff.sh

[ -n "$PUID" ] && UID="$PUID"
[ -n "$PGID" ] && GID="$PGID"
[ -n "$UMASK" ] && umask "$UMASK"

if [ "$(ls -nd /config | tr -s '[:space:]' | cut -d' ' -f3)" -ne "$UID" ] || [ "$(ls -nd /config | tr -s '[:space:]' | cut -d' ' -f4)" -ne "$GID" ]; then
  chown "$UID":"$GID" -R /config
fi

for d in $(find /dev/dri -type c 2>/dev/null); do
  gid=$(stat -c %g "${d}")
  [ -z "${GIDLIST}" ] && GIDLIST=${gid} || GIDLIST="${GIDLIST},${gid}"
done

if [ -n "$(uname -a | grep -q synology)" ] || [ "$IGNORE_VAAPI_ENABLED_FLAG" = "true" ]; then
  s6-applyuidgid -U /system/EmbyServer \
      -programdata /config \
      -ffdetect /bin/ffdetect \
      -ffmpeg /bin/ffmpeg \
      -ffprobe /bin/ffprobe \
      -ignore_vaapi_enabled_flag \
      -restartexitcode 3
else
  s6-applyuidgid -U /system/EmbyServer \
      -programdata /config \
      -ffdetect /bin/ffdetect \
      -ffmpeg /bin/ffmpeg \
      -ffprobe /bin/ffprobe \
      -restartexitcode 3
fi

# vim: ts=2 sw=2 et: