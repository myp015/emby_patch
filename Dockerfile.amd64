# ============================================================
# amd64 补丁版 Dockerfile
# 基础镜像：amilys/embyserver (amd64)
# 用法（由 build-multiarch.sh 调用，或手动）：
#   docker buildx build --platform linux/amd64 \
#     -t emby-amd64:patched -f Dockerfile.amd64 \
#     --build-arg DASH_DIR=/system/dashboard-ui --load .
# ============================================================
ARG AMD64_BASE=amilys/embyserver:latest
ARG DASH_DIR=/system/dashboard-ui
FROM ${AMD64_BASE}

# 固化补丁：embyLaunchPotplayer.js（外部播放器增强，与架构无关）
ARG DASH_DIR
COPY files/embyLaunchPotplayer.js ${DASH_DIR}/embyLaunchPotplayer.js

# 固化补丁：改版 index.html（已含 <script src="embyLaunchPotplayer.js"></script>）
COPY index.html ${DASH_DIR}/index.html